---
import AuthLayout from "../layout/AuthLayout.astro";

const emailCookie = Astro.cookies.get("email");
const rememberMe = !!emailCookie;
---

<AuthLayout title="Register">
  <form action="">
    <fieldset class="fieldset bg-base-200 rounded-box w-xs border-2 p-4">
      <legend class="fieldset-legend text-2xl font-bold">Inscripcion</legend>

      <label class="label">Nombre</label>
      <input
        name="name"
        type="text"
        class="input"
        placeholder="Nombre"
        required
      />

      <label class="label">Email</label>
      <input
        name="email"
        type="email"
        value={emailCookie ? emailCookie.value : ""}
        class="input"
        placeholder="Email"
        required
      />

      <label class="label">Password</label>
      <input
        name="password"
        type="password"
        class="input"
        placeholder="Password"
        required
      />

      <label class="label">Edad</label>
      <input
        min="1"
        name="edad"
        type="number"
        class="input"
        placeholder="Edad"
        required
      />

      <div class="divider m-0 p-0 mt-2"></div>

      <div class="flex flex-col gap-5">
        <p class="font-bold text-xl">A que iglesia perteneces?</p>

        <div class="form-control">
          <label class="label cursor-pointer">
            <span class="label-text">Iglesia Vida Sobrenatural</span>
            <input
              type="radio"
              name="tipoIglesia"
              value="Vida Sobrenatural"
              class="radio"
              checked
            />
          </label>
        </div>

        <div class="form-control">
          <label class="label cursor-pointer">
            <span class="label-text">Otra iglesia</span>
            <input
              type="radio"
              name="tipoIglesia"
              value="Otra iglesia"
              class="radio"
            />
          </label>
        </div>
        <div
          class="overflow-hidden transition-all duration-300 ease-in-out max-h-0 opacity-0"
          id="iglesiaNombreContainer"
        >
          <input
            id="iglesiaDifNombre"
            name="iglesiaDifNombre"
            type="text"
            class="input mt-2 w-full"
            placeholder="Nombre de tu congregación"
          />
        </div>

        <div class="form-control">
          <label class="label cursor-pointer">
            <span class="label-text">No pertenezco a ninguna iglesia</span>
            <input
              name="tipoIglesia"
              type="radio"
              value="ninguna"
              class="radio"
            />
          </label>
        </div>
      </div>

      <!-- checkboxes inputs 
      <div class="flex gap-2 items-center">
        <label class="label">Perteneces a iglesia Vida Sobrenatural:</label>
        <input
          id="iglesiaVS"
          name="iglesiaVS"
          type="checkbox"
          class="checkbox"
        />
      </div>
      <div class="flex flex-col mt-2">
        <div class="flex gap-2 items-center">
          <label class="label">Perteneces a otra iglesia diferente:</label>
          <input
            id="iglesiaDif"
            name="iglesiaDif"
            type="checkbox"
            class="checkbox"
          />
        </div>

        <div class="gap-2 items-center mt-2 hidden" id="iglesiaDifNombre">
          <label class="label">Nombre de la iglesia:</label>
          <input
            name="iglesiaDifNombre"
            type="text"
            class="input"
            placeholder="Tu congregacion"
            required
          />
        </div>
      </div> -->
      <button
        id="register-btn"
        type="submit"
        class="btn btn-neutral disabled:opacity-50 mt-5">Inscribirse</button
      >
    </fieldset>
  </form>
</AuthLayout>

<script>
  import { actions } from "astro:actions";

  document.addEventListener("DOMContentLoaded", () => {
    const formulario = document.querySelector("form") as HTMLFormElement;
    const btn = document.querySelector("#register-btn") as HTMLButtonElement;
    const iglesiaNombreContainer = document.querySelector(
      "#iglesiaNombreContainer"
    ) as HTMLDivElement;
    const iglesiaNombreInput = document.querySelector(
      "#iglesiaDifNombre"
    ) as HTMLInputElement;

    formulario.addEventListener("change", (e) => {
      const target = e.target as HTMLInputElement;

      if (target.name === "tipoIglesia") {
        if (target.value === "Otra iglesia") {
          // Mostrar con animación
          iglesiaNombreContainer.classList.remove("max-h-0", "opacity-0");
          iglesiaNombreContainer.classList.add("max-h-20", "opacity-100");
          iglesiaNombreInput.required = true;
        } else {
          // Ocultar con animación
          iglesiaNombreContainer.classList.remove("max-h-20", "opacity-100");
          iglesiaNombreContainer.classList.add("max-h-0", "opacity-0");
          iglesiaNombreInput.required = false;
          iglesiaNombreInput.value = "";
        }
      }
    });

    formulario.addEventListener("submit", async (e) => {
      e.preventDefault();
      btn.setAttribute("disabled", "true");

      const formData = new FormData(formulario);
      const { data: registerData } = await actions.registerUser(formData);
      const jsonToDb = {
        uid: registerData?.uid!,
        name: formData.get("name") as string,
        edad: Number(formData.get("edad")),
        iglesiaVS: formData.get("iglesiaVS") === "on" ? true : false,
        iglesiaExterna: formData.get("iglesiaExterna") as string,
      };

      const { data: inscripcionResult } = await actions.inscripcionDB(jsonToDb);
      if (registerData?.success && inscripcionResult?.success) {
        alert("Usuario registrado e inscrito con éxito");
        window.location.replace("/");
      } else {
        alert("usuario con correo repetido");
        //TODO: MANEJAR BIEN LOS ERRORES.
        return;
      }
      btn.removeAttribute("disabled");
    });
  });
</script>
