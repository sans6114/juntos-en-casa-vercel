---
import "../../styles/global.css";
import { Sorteo as ComponentSorteoReact } from "../../components/admin/Sorteo.tsx";
import NavBar from "../../components/auth/NavBar.astro";
import { getInscripcionesStats } from "../../scripts/get-inscripciones-stats";
const response = await getInscripcionesStats();
// Reducir a datos serializables (sin Timestamps/refs)
const date = response.inscripciones.map((i: any) => ({
  nombre: String(i?.name ?? i?.nombre ?? ""),
  apellido: String(i?.lastName ?? i?.apellido ?? ""),
}));
const { isAdmin } = Astro.locals;
if (!isAdmin) {
  alert("No tienes permiso para acceder a esta página.");
  Astro.redirect("/login");
  return;
}
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <title>Sorteo - Juntos en Casa</title>
  </head>
  <body>
    <NavBar />
    <main class="max-w-7xl mx-auto px-4 py-10 min-h-screen mt-20">
      <div class="grid-title">
        <h1 class="text-7xl font-bold text-center mb-10">Sorteo</h1>
        <img src="/personaje/fuegoapuntandoizq.png" alt="Sorteo" />
      </div>

      <ComponentSorteoReact inscripciones={date} client:load server:defer />
    </main>
  </body>
</html>

<style>
  .grid-title {
    display: grid;
    width: 400px;
    grid-template-columns: 3fr 4fr;
    align-items: center;
    margin: 0 auto;
  }
</style>
