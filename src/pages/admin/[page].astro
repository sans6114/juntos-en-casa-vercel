---
import type { GetStaticPaths } from "astro";
import AdminLayout from "../../layout/AdminLayout.astro";
import { getInscripcionesStats } from "../../scripts/get-inscripciones-stats";
import EstadisticasDatos from "../../components/admin/EstadisticasDatos.astro";
const response = await getInscripcionesStats();
const date = response.inscripciones;
const { isAdmin } = Astro.locals;
if (!isAdmin) {
  alert("No tienes permiso para acceder a esta página.");
  Astro.redirect("/login");
  return;
}
---

<AdminLayout>
  {
    date && date ? (
      <table class="table table-xs md:table-md p-4" slot="admin-table">
        <thead>
          <tr>
            <th>#</th>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Edad</th>
            <th>Iglesia</th>
          </tr>
        </thead>
        <tbody>
          {date.map((inscripcion, idx) => (
            <tr>
              <th>{idx + 1}</th>
              <td>{inscripcion.name}</td>
              <td>{inscripcion.apellido}</td>
              <td>{inscripcion.edad}</td>
              <td>
                {inscripcion.iglesiaVS
                  ? "Vida Sobrenatural"
                  : inscripcion.iglesiaDif
                    ? inscripcion.iglesiaDifNombre
                    : inscripcion.iglesiaNone
                      ? "Sin iglesia"
                      : ""}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    ) : (
      // <div class="join flex justify-center my-8">
      //   <a
      //     href={date.url.prev}
      //     class={`join-item btn ${
      //       page.currentPage === 1
      //         ? "bg-gray-600 text-gray-400 hover:cursor-not-allowed"
      //         : ""
      //     }`}
      //   >
      //     « anteriores
      //   </a>
      //   <button class="join-item btn">{page.currentPage}</button>
      //   <a
      //     href={page.url.next}
      //     class={`join-item btn ${
      //       page.currentPage === page.lastPage ? "bg-gray-600 text-gray-400 hover:cursor-not-allowed" : ""
      //     }`}
      //   >
      //     siguientes »
      //   </a>
      // </div>
      <div class="text-center p-8">
        <p>Error: No se pudieron cargar los datos de paginación.</p>
      </div>
    )
  }
  <EstadisticasDatos stats={response} slot="admin-stats" />
</AdminLayout>
