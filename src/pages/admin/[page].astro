---
import AdminLayout from "../../layout/AdminLayout.astro";
import type { GetStaticPaths } from "astro";
import { getInscripcionesStats } from "../../scripts/get-inscripciones-stats";
export const getStaticPaths = (async ({ paginate }) => {
  const response = await getInscripcionesStats();
  console.log("getStaticPaths response:", response);

  if (!response?.inscripciones || response.inscripciones.length === 0) {
    console.log("No inscriptions found, returning empty pagination");
    return paginate([], { pageSize: 2 });
  }

  console.log("Paginating inscriptions:", response.inscripciones.length);
  return paginate(response.inscripciones, { pageSize: 2 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

// ✅ Agregar esta validación
if (!page) {
  throw new Error("Page is undefined - getStaticPaths may have failed");
}

console.log("Page object received:", {
  currentPage: page.currentPage,
  total: page.total,
  dataLength: page.data?.length,
});
---

<AdminLayout>
  <!-- Validación adicional en el template -->
  {page && page.data ? (
    <table class="table table-md">
      <thead>
        <tr>
          <th>#</th>
          <th>Nombre</th>
          <th>Apellido</th>
          <th>Edad</th>
          <th>Iglesia</th>
          <th>Fecha inscripción</th>
        </tr>
      </thead>
      <tbody>
        {page.data.map((inscripcion, idx) => (
          <tr>
            <th>{idx + 1}</th>
            <td>{inscripcion.name}</td>
            <td>{inscripcion.apellido}</td>
            <td>{inscripcion.edad}</td>
            <td>
              {inscripcion.iglesiaVS
                ? "Vida Sobrenatural"
                : inscripcion.iglesiaDif
                ? inscripcion.iglesiaDifNombre
                : inscripcion.iglesiaNone
                ? "Sin iglesia"
                : ""}
            </td>
            <td>
              {inscripcion.timestamp
                ? new Date(inscripcion.timestamp).toLocaleDateString()
                : ""}
            </td>
          </tr>
        ))}
      </tbody>
    </table>

    <div class="join flex justify-center my-8">
      <a
        href={page.url.prev}
        class={`join-item btn ${
          page.currentPage === 1
            ? "bg-gray-600 text-gray-400 hover:cursor-not-allowed"
            : ""
        }`}
      >
        « anteriores
      </a>
      <button class="join-item btn">{page.currentPage}</button>
      <a
        href={page.url.next}
        class={`join-item btn ${
          page.currentPage === page.total ? "disabled" : ""
        }`}
      >
        siguientes »
      </a>
    </div>
  ) : (
    <div class="text-center p-8">
      <p>Error: No se pudieron cargar los datos de paginación.</p>
    </div>
  )}
</AdminLayout>
