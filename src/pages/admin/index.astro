---
import Heading from "../../components/shared/Heading.astro";
import EstadisticasDatos from "../../components/admin/EstadisticasDatos.astro";
import InscripcionLayout from "../../layout/InscripcionLayout.astro";
import { getInscripcionesStats } from "../../scripts/get-inscripciones-stats";
import type { Stats } from "../../interfaces";

const { isAdmin } = Astro.locals;
const estadisticas = (await getInscripcionesStats()) as Stats;
---

<InscripcionLayout title="Admin - Juntos en Casa 2025">
  <section
    class="max-w-5xl mx-auto flex flex-col items-center justify-center min-h-screen"
  >
    <Heading
      text="Panel de Administración"
      class="text-4xl text-center mb-10"
    />
    <div class="flex flex-col md:flex-row gap-10">
      <div class="overflow-x-auto mt-10">
        <table class="table table-md">
          <thead>
            <tr>
              <th>#</th>
              <th>Nombre</th>
              <th>Apellido</th>
              <th>Edad</th>
              <th>Iglesia</th>
              <th>Fecha inscripción</th>
            </tr>
          </thead>
          <tbody>
            {
              estadisticas.inscripciones.map((inscripcion, idx) => (
                <tr>
                  <th>{idx + 1}</th>
                  <td>{inscripcion.name}</td>
                  <td>{inscripcion.apellido}</td>
                  <td>{inscripcion.edad}</td>
                  <td>
                    {inscripcion.iglesiaVS
                      ? "Vida Sobrenatural"
                      : inscripcion.iglesiaDif
                        ? inscripcion.iglesiaDifNombre
                        : inscripcion.iglesiaNone
                          ? "Sin iglesia"
                          : ""}
                  </td>
                  <td>
                    {inscripcion.timestamp
                      ? new Date(inscripcion.timestamp).toLocaleDateString()
                      : ""}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      {estadisticas && <EstadisticasDatos stats={estadisticas} />}
    </div>
  </section>
</InscripcionLayout>
