---
import MainLayout from "../layout/MainLayout.astro";

// astro nos permite manejar redirecciones de forma muy sencilla
// if (true) {
//   return Astro.redirect("/login");
// }

// const firebaseUser = firebase.auth.currentUser;
// if (!firebaseUser) {
//   return Astro.redirect("/login");
// }
// await firebaseUser.reload();

const { user, isAdmin } = Astro.locals;
const firebaseUser = user;
---

<!-- component -->
<div
  class="bg-gray-200 font-sans h-screen w-full flex flex-row justify-center items-center"
>
  <div class="card w-96 mx-auto bg-white shadow-xl hover:shadow">
    {
      firebaseUser?.avatar ? (
        <img
          class="w-32 mx-auto rounded-full -mt-20 border-8 border-white"
          src={firebaseUser.avatar}
          alt=""
        />
      ) : (
        <div class="w-32 h-32 mx-auto rounded-full -mt-20 border-8 border-white bg-gray-300 flex justify-center items-center">
          <span class="text-white text-3xl font-extrabold">
            {firebaseUser?.name}
          </span>
        </div>
      )
    }

    <div class="text-center mt-2 text-3xl font-medium">
      {firebaseUser?.name}
    </div>
    <div class="text-center mt-2 text-3xl font-medium">
      idAdmin: {isAdmin ? "true" : "false"}
    </div>
    <div class="text-center mt-2 font-light text-sm">
      {firebaseUser?.email}
    </div>
    <div class="text-center mt-2 font-light text-sm">
      {firebaseUser?.emailVerified ? "Email verified" : "Email not verified"}
    </div>
    <hr class="mt-8" />
    <div class="flex p-4">
      <div class="w-1/2 text-center">
        <span class="font-bold">1.8 k</span> Followers
      </div>
      <div class="w-0 border border-gray-300"></div>
      <div class="w-1/2 text-center">
        <span class="font-bold">2.0 k</span> Following
      </div>
    </div>
  </div>
</div>
