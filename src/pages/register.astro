---
import AuthLayout from "../layout/AuthLayout.astro";

const emailCookie = Astro.cookies.get("email");
const rememberMe = !!emailCookie;
---

<AuthLayout title="Register">
  <form action="">
    <fieldset class="fieldset bg-base-200 rounded-box w-xs border-2 p-4">
      <legend class="fieldset-legend text-2xl font-bold">Register</legend>

      <label class="label">Name</label>
      <input
        name="name"
        type="text"
        class="input"
        placeholder="Name"
        required
      />

      <label class="label">Email</label>
      <input
        name="email"
        type="email"
        value={emailCookie ? emailCookie.value : ""}
        class="input"
        placeholder="Email"
        required
      />

      <label class="label">Password</label>
      <input
        name="password"
        type="password"
        class="input"
        placeholder="Password"
        required
      />

      <button class="btn bg-white text-black border border-gray-500 mt-4">
        <svg
          aria-label="Google logo"
          width="16"
          height="16"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 512 512"
          ><g
            ><path d="m0 0H512V512H0" fill="#fff"></path><path
              fill="#34a853"
              d="M153 292c30 82 118 95 171 60h62v48A192 192 0 0190 341"
            ></path><path
              fill="#4285f4"
              d="m386 400a140 175 0 0053-179H260v74h102q-7 37-38 57"
            ></path><path
              fill="#fbbc02"
              d="m90 341a208 200 0 010-171l63 49q-12 37 0 73"></path><path
              fill="#ea4335"
              d="m153 219c22-69 116-109 179-50l55-54c-78-75-230-72-297 55"
            ></path></g
          ></svg
        >
        Login with Google
      </button>

      <button
        id="register-btn"
        type="submit"
        class="btn btn-neutral disabled:opacity-50">register</button
      >
      <div class="flex gap-2 items-center mt-2">
        <label class="label">Remember me</label>
        <input
          type="checkbox"
          checked={rememberMe}
          name="remember_me"
          class="checkbox checkbox-sm"
        />
      </div>

      <a href="/login" class="btn btn-link"
        >You already have an account? Login</a
      >
    </fieldset>
  </form>
</AuthLayout>

<script>
  import { actions } from "astro:actions";

  document.addEventListener("DOMContentLoaded", () => {
    const formulario = document.querySelector("form") as HTMLFormElement;
    const btn = document.querySelector("#register-btn") as HTMLButtonElement;

    formulario.addEventListener("submit", async (e) => {
      e.preventDefault();
      btn.setAttribute("disabled", "true");

      const formData = new FormData(formulario);
      const { data, error } = await actions.registerUser(formData);
      if (data) {
        if (data.success) {
          window.location.replace("/admin");
        } else {
          alert("usuario con correo repetido");
          return;
        }
      }

      btn.removeAttribute("disabled");
    });
  });
</script>
