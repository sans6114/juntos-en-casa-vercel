---
import Heading from "../components/shared/Heading.astro";
import InscripcionLayout from "../layout/InscripcionLayout.astro";

const { user, inscripcion, isLoggedIn } = Astro.locals;
if (!isLoggedIn) {
  // Redirigir a la página de inicio de sesión si no está autenticado
  Astro.redirect("/login");
}
---

<InscripcionLayout title="Inscripción - Juntos en Casa 2025">
  <section
    class="overflow-hidden py-10 flex flex-col md:flex-row items-center justify-center md:px-4 md:gap-10"
  >
    <form action="" class="order-2 md:order-1 mt-10 md:mt-0">
      <fieldset class="fieldset bg-base-200 rounded-box w-xs border-2 p-4">
        <legend class="font-semibold text-xl">Tus datos</legend>
        <label class="label">Nombre</label>
        <input
          name="name"
          value={inscripcion?.name || ""}
          type="text"
          class="input validator"
          placeholder="Nombre"
          required
          minlength="2"
          maxlength="50"
          pattern="^[A-Za-zÀ-ÖØ-öø-ÿ\s]+$"
        />
        <div class="validator-hint">Tu nombre debe contener solo letras.</div>

        <label class="label">Apellido</label>
        <input
          name="apellido"
          type="text"
          class="input validator"
          value={inscripcion?.apellido || ""}
          placeholder="Apellido"
          required
          minlength="2"
          maxlength="50"
          pattern="^[A-Za-zÀ-ÖØ-öø-ÿ\s]+$"
        />
        <div class="validator-hint">Tu apellido debe contener solo letras.</div>

        <label class="label">Edad</label>
        <input
          min="1"
          name="edad"
          value={inscripcion?.edad || ""}
          type="number"
          class="input validator"
          placeholder="Edad"
          required
        />
        <div class="validator-hint">Por favor ingresa una edad válida.</div>

        <div class="divider m-0 p-0 mt-2"></div>

        <div class="flex flex-col gap-5">
          <p class="font-bold text-xl">A que iglesia perteneces?</p>
          {
            inscripcion?.iglesiaVS && (
              <p class="font-bold text-md">
                Perteneces a la iglesia Vida Sobrenatural
              </p>
            )
          }
          {
            inscripcion?.iglesiaDif && (
              <p class="font-bold text-md">
                Perteneces a la iglesia: "{inscripcion.iglesiaDifNombre}"
              </p>
            )
          }
        </div>
      </fieldset>
    </form>
    <div class="relative self-start order-1 md:order-2 flex flex-col">
      <img
        class="z-20 absolute right-[-3.2rem] top-[-2rem] w-48 md:w-[300px] xl:w-[600px] order-1 md:order-2"
        src="/personaje/fuegoapuntandoizq.png"
        alt="personaje animado"
        srcset=""
      />
      <Heading
        class="text-start ml-3 md:ml-0 md:text-6xl"
        text="Bienvenido a los datos de tu inscripción!"
      />
      <p class="ml-3 w-60 md:w-full md:text-xl mt-5">
        Estos son tus datos personales que cargaste al inscribirte en la
        inscripción de la conferencia.
      </p>
    </div>
  </section>
</InscripcionLayout>
