---
import "../styles/global.css";
import NavBar from "../components/shared/NavBar.astro";
import Header from "../components/Header.astro";
import { siteConfig } from "../siteConfig";
import Footer from "../components/shared/Footer.astro";
import QYA from "../components/QYA.astro";
import Oradores from "../components/Oradores.astro";
import { oradores } from "../information/oradores";
import { preguntasRespuestas } from "../information/preguntas-respuestas";
import Bienvenida from "../components/Bienvenida.astro";
import Cronograma from "../components/Cronograma.astro";

const { title, description } = siteConfig;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://juntosencasa.ivs.netlify.app" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
  </head>
  <body class="h-screen relative overflow-x-hidden">
    <div class="max-w-7xl mx-auto relative z-20">
      <NavBar />
    </div>
    <main
      class="flex flex-col justify-center min-h-screen items-center overflow-hidden"
    >
      <section id="header" class="w-full">
        <Header />
      </section>
      <Bienvenida />
      <section id="oradores" class="w-full">
        <Oradores oradores={oradores} />
      </section>
      <section id="cronograma" class="w-full">
        <Cronograma />
      </section>
      <section id="preguntas">
        <QYA questionAnswer={preguntasRespuestas} />
      </section>
    </main>
    <Footer />
    <script>
      import AOS from "aos";
      import "aos/dist/aos.css";

      // ✅ Inicialización simple
      document.addEventListener("DOMContentLoaded", () => {
        AOS.init();
      });
    </script>
  </body>
</html>
