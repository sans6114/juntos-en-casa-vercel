---
import InscripcionLayout from "../layout/InscripcionLayout.astro";
import Inscripcion from "./inscripcion.astro";

const emailCookie = Astro.cookies.get("email")?.value || "";
---

<InscripcionLayout title="Login">
  <form class="flex flex-col items-center my-10 p-10" action="">
    <fieldset class="fieldset bg-base-200 rounded-box w-xs border-2 p-4">
      <legend class="fieldset-legend text-2xl font-bold"
        >Entrar a tu cuenta</legend
      >

      <label class="label">Email</label>
      <input
        type="email"
        name="email"
        value={emailCookie}
        class="input"
        placeholder="Email"
      />

      <label class="label">Contraseña</label>
      <input
        name="password"
        type="password"
        class="input"
        placeholder="Contraseña"
      />

      <button
        id="login-google-button"
        class="btn bg-white text-black border border-gray-500 mt-4"
      >
        <svg
          aria-label="Google logo"
          width="16"
          height="16"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 512 512"
          ><g
            ><path d="m0 0H512V512H0" fill="#fff"></path><path
              fill="#34a853"
              d="M153 292c30 82 118 95 171 60h62v48A192 192 0 0190 341"
            ></path><path
              fill="#4285f4"
              d="m386 400a140 175 0 0053-179H260v74h102q-7 37-38 57"
            ></path><path
              fill="#fbbc02"
              d="m90 341a208 200 0 010-171l63 49q-12 37 0 73"></path><path
              fill="#ea4335"
              d="m153 219c22-69 116-109 179-50l55-54c-78-75-230-72-297 55"
            ></path></g
          ></svg
        >
        Login with Google
      </button>

      <button
        type="submit"
        id="login-button"
        class="btn btn-neutral disabled:opacity-50">Login</button
      >
      <a href="/inscripcion" class="btn btn-link"
        >No estas inscripto? inscribite!</a
      >
    </fieldset>
  </form>
</InscripcionLayout>

<script>
  import { actions } from "astro:actions";
  import { GoogleAuthProvider, signInWithPopup } from "firebase/auth";
  import { firebase } from "../firebase/config";

  addEventListener("DOMContentLoaded", () => {
    const formulario = document.querySelector("form") as HTMLFormElement;
    const btn = formulario.querySelector("#login-button") as HTMLButtonElement;
    const btnGoogle = formulario.querySelector(
      "#login-google-button"
    ) as HTMLButtonElement;

    //normal sigin
    formulario.addEventListener("submit", async (e) => {
      e.preventDefault();
      btn.setAttribute("disabled", "true");
      const formData = new FormData(formulario);
      const { data, error } = await actions.loginUser(formData);
      if (!data.ok) {
        throw new Error(data.msg);
      }
      // Redirigir al usuario a la página de administración
      window.location.replace("/admin/1");
      btn.removeAttribute("disabled");
    });

    //google signin
    btnGoogle.addEventListener("click", async (e) => {
      e.preventDefault();
      btnGoogle.setAttribute("disabled", "true");
      const provider = new GoogleAuthProvider();
      try {
        //obtenemos las credenciales del lado del cliente.
        const credential = await signInWithPopup(firebase.auth, provider);

        //verificar las credenciales en el backend
        const { data, error } = await actions.loginGoogleUser(credential);
        if (error) {
          throw new Error(error.message);
        }
        btnGoogle.innerText = "Redirecting...";
        window.location.replace("/admin");
      } catch (error) {
        console.error(error);
      }
      btnGoogle.removeAttribute("disabled");
    });
  });
</script>
