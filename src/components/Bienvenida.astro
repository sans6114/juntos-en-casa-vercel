---
import Carousel from "./shared/Carousel.astro";
import Logo from "./shared/Logo.astro";
---

<div class="grid-bienvenida w-full h-screen overflow-hidden bg-black relative">
  <!-- Texto que aparece después -->
  <div
    class="max-h-[300px] md:self-start children-1"
    data-aos="fade-right"
    data-aos-delay="100"
    data-aos-duration="800"
  >
    <Logo class="w-xs md:w-xl" />
  </div>
  <!-- <div
    class="flex flex-col gap-4 text-4xl md:text-6xl font-bold text-white drop-shadow-2xl mt-10 ml-4"
  >
    <span class="font-extrabold" data-aos="fade-down" data-aos-delay="300"
      >Unidad</span
    >
    <span class="font-extrabold" data-aos="fade-down" data-aos-delay="500"
      >Poder</span
    >
    <span class="font-extrabold" data-aos="fade-down" data-aos-delay="700"
      >Renovación</span
    >
    <span class="font-extrabold" data-aos="fade-down" data-aos-delay="900"
      >Sobrenatural</span
    >
    <span class="font-extrabold" data-aos="fade-down" data-aos-delay="1100"
      >Desafiante</span
    >
  </div> -->

  <div
    data-aos="fade-right"
    data-aos-delay="100"
    data-aos-duration="800"
    class="children-2"
  >
    <p class="text-white text-center font-semibold text-2xl px-10">
      "Por eso les digo: dejen que el Espíritu Santo los guíe en la vida"<br />
      Gálatas 5:25
    </p>
  </div>
  <div class="children-3 flex justify-center">
    <Carousel />
  </div>
</div>
<style>
  .grid-bienvenida {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    grid-template-rows: repeat(5, 1fr);
    gap: 8px;

    .children-1 {
      grid-row-start: 1;
      grid-row-end: 2;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .children-2 {
      grid-column-start: 1;
      grid-row-start: 2;
      grid-row-end: 3;
    }
    .children-3 {
      grid-column-start: 1;
      grid-row-start: 3;
      grid-row-end: 5;
    }
  }
  @media (min-width: 1024px) {
    .grid-bienvenida {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      grid-template-rows: repeat(5, 1fr);
      gap: 8px;

      .children-1 {
        grid-column: span 2 / span 2;
        grid-row: span 2 / span 2;
      }
      .children-2 {
        grid-column: span 2 / span 2;
        grid-row: span 2 / span 2;
        grid-column-start: 1;
        grid-row-start: 4;
      }
      .children-3 {
        grid-column: span 2 / span 2;
        grid-row: span 4 / span 4;
        grid-column-start: 4;
        grid-row-start: 2;
      }
    }
  }
  .personaje {
    bottom: -80px;
    width: 300px;
  }
  /* Tablets grandes (1024px+) */
  @media (min-width: 1024px) {
    .personaje {
      bottom: -100px;
      right: 80px;
      width: 350px;
    }
  }
</style>
