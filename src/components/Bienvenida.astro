---
import Logo from "./shared/Logo.astro";
---

<div
  class="relative w-full h-screen flex flex-col md:flex-row md:items-center overflow-hidden bg-black"
>
  <!-- Texto que aparece después -->
  <div
    class="max-h-[300px] md:self-start"
    data-aos="fade-right"
    data-aos-delay="100"
    data-aos-duration="800"
  >
    <Logo size="md" />
  </div>
  <div
    class="flex flex-col gap-4 text-4xl md:text-6xl font-bold text-white drop-shadow-2xl mt-10 ml-4"
  >
    <span class="font-extrabold" data-aos="fade-down" data-aos-delay="300"
      >Unidad</span
    >
    <span class="font-extrabold" data-aos="fade-down" data-aos-delay="500"
      >Poder</span
    >
    <span class="font-extrabold" data-aos="fade-down" data-aos-delay="700"
      >Renovación</span
    >
    <span class="font-extrabold" data-aos="fade-down" data-aos-delay="900"
      >Sobrenatural</span
    >
    <span class="font-extrabold" data-aos="fade-down" data-aos-delay="1100"
      >Desafiante</span
    >
  </div>
  <!-- Personaje que entra desde la derecha y se mueve a la izquierda -->
  <img
    src="/personaje/fuegoorando.svg"
    alt="Personaje orando con fuego"
    class="absolute personaje"
    data-aos="fade-up"
    data-aos-delay="1300"
  />
</div>
<style>
  .personaje {
    bottom: -80px;
    width: 300px;
  }
  /* Tablets grandes (1024px+) */
  @media (min-width: 1024px) {
    .personaje {
      bottom: -100px;
      right: 80px;
      width: 350px;
    }
  }
</style>
