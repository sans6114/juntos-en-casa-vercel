---
import { imagesCarousel } from "../information/imagenesCarousel";
import Carousel from "./shared/Carousel.astro";
import Logo from "./shared/Logo.astro";
---

<div class="relative grid-bienvenida w-full h-screen overflow-hidden bg-black">
  <!-- Texto que aparece después -->
  <div
    class="max-h-[300px] md:self-start children-1"
    data-aos="fade-right"
    data-aos-delay="100"
    data-aos-duration="800"
  >
    <Logo class="w-xs md:w-xl" />
  </div>
  <div class="children-2 flex justify-center">
    <Carousel images={imagesCarousel} />
  </div>
</div>
<style>
  .grid-bienvenida {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    grid-template-rows: repeat(6, 1fr);
    gap: 8px;

    .children-1 {
      grid-row-start: 1;
      grid-row-end: 2;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .children-2 {
      grid-column-start: 1;
      grid-row-start: 2;
      grid-row-end: 5;
    }
    .children-3 {
      grid-column-start: 1;
      grid-row-start: 4;
      grid-row-end: 5;
    }
  }
  @media (min-width: 1024px) {
    .grid-bienvenida {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      grid-template-rows: repeat(5, 1fr);
      gap: 8px;

      .children-1 {
        grid-column: span 2 / span 2;
        grid-row: span 2 / span 2;
      }
      .children-2 {
        grid-column: span 2 / span 2;
        grid-row: span 2 / span 2;
        grid-column-start: 1;
        grid-row-start: 4;
      }
      .children-3 {
        grid-column: span 2 / span 2;
        grid-row: span 4 / span 4;
        grid-column-start: 4;
        grid-row-start: 2;
      }
    }
  }
  .personaje {
    z-index: 100;
    bottom: 40px;
    width: 300px;
  }
  /* Tablets grandes (1024px+) */
  @media (min-width: 1024px) {
    .personaje {
      bottom: -100px;
      right: 80px;
      width: 350px;
    }
  }
</style>
