---
import type { Orador } from "../interfaces/Orador";

interface Props {
  orador: Orador;
}
const { orador } = Astro.props;
---

<div
  data-aos="fade-down"
  data-aos-delay="5000"
  data-aos-delay="400"
  class="card lg:card-side shadow-xl w-[320px] h-[450px] md:w-full"
>
  <figure>
    <img class="object-top" src={orador.imagen} alt="Album" />
  </figure>
  <div class="card-body">
    <h2 class="card-title">{orador.nombre}</h2>
  </div>
</div>
