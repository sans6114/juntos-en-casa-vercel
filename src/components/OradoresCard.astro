---
import type { Orador } from "../interfaces/Orador";

interface Props {
  orador: Orador;
}
const { orador } = Astro.props;
---

<div
  data-aos="fade-left"
  data-aos-delay="300"
  data-aos-duration="6000"
  class="card lg:card-side shadow-2xl border w-[300px] h-[500px] md:w-full"
>
  <figure>
    <img class="object-top" src={orador.imagen} alt="Album" />
  </figure>
  <div class="card-body">
    <h2 class="card-title">{orador.nombre}</h2>
    <p>{orador.descripcion}</p>
  </div>
</div>
