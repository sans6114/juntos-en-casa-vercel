---
import { Icon } from "astro-icon/components";

enum Tamanio {
  xs = "btn-xs",
  sm = "btn-sm",
  md = "btn",
  lg = "btn-lg",
  xl = "btn-xl",
}
interface Props {
  tamanio?: keyof typeof Tamanio;
  href?: string;
  text: string;
  iconName: string;
  class?: string;
}

const {
  href,
  text,
  iconName,
  class: className = "",
  tamanio = "md",
} = Astro.props;
---

<button
  class={`flex items-center btn btn-primary w-fit ${className} ${Tamanio[tamanio]}`}
>
  <Icon name={iconName} class="inline-block w-6 h-6" />
  <a href={href}>
    {text}
  </a>
</button>
