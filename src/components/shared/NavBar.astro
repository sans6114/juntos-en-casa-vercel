---
import { Icon } from "astro-icon/components";
import Logo from "./Logo.astro";
import ThemeSwitcher from "./ThemeSwitcher.astro";

interface Route {
  name: string;
  to: string;
}

const routes: Route[] = [
  { name: "Oradores", to: "#oradores" },
  { name: "Cronograma", to: "#cronograma" },
];

const { isLoggedIn,isAdmin } = Astro.locals
---

<div
  class="!fixed inset-x-0 top-4 navbar shadow-sm rounded-full backdrop-blur-md md:w-2/4 mx-auto w-3/4 border-white border-2"
>
    <a href="/" class="navbar-start">
    <img
      src="src/assets/logoVSblanco.png"
      alt="Logo iglesia vida sobrenatural"
      class="w-8 h-auto"
    />
  </a>
  <div class="navbar-end">
    <div class="dropdown dropdown-end">
      <div tabindex="0" role="button" class="btn btn-ghost btn-circle">
        <Icon name="mdi:menu" class="w-8 h-8" color="white" />
      </div>
      <ul
        tabindex="0"
        class="menu menu-sm dropdown-content bg-base-100 rounded-box z-1 mt-3 w-52 p-2 shadow flex flex-col gap-4"
      >
        {
          routes.map((route) => (
            <a class="btn btn-outline btn-primary" href={route.to}>
              {route.name}
            </a>
          ))
        }
        {
          !isLoggedIn ? (
              <a class="btn btn-outline btn-primary" href="/inscripcion">Inscribirme</a>
          ) : (
              <a class="btn btn-outline btn-primary" href="/mi-inscripcion">Mi Inscripción</a>
              <button id="logout" class="btn btn-secondary w-full">
                <Icon name="mdi:logout" class="w-6 h-6 mr-2" />
                Cerrar sesión
              </button>
          )
        }
        {
          isAdmin && (
            <li class="btn btn-outline btn-primary">
              <a href="/admin">admin</a>
            </li>
          )
        }
      </ul>
    </div>
  </div>
</div>
<script>
  import { actions } from "astro:actions";

  document.addEventListener("DOMContentLoaded", () => {
    const logoutButton = document.querySelector("#logout") as HTMLButtonElement;
    logoutButton.addEventListener("click", async () => {
      await actions.logoutUser();
      window.location.href = "/";
    });
  });
</script>
