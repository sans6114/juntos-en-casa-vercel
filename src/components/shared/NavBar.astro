---
import { firebase } from "../../firebase/config";
import ThemeSwitcher from "./ThemeSwitcher.astro";

const { isLoggedIn } = Astro.locals;
---

<div
  class="!fixed inset-x-0 top-4 navbar shadow-sm rounded-full backdrop-blur-md md:w-2/4 mx-auto w-3/4 light:border-black border-2 dark:border-black"
>
  <div class="navbar-start">
    <div class="dropdown">
      <div tabindex="0" role="button" class="btn btn-ghost btn-circle">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h7"></path>
        </svg>
      </div>
      <ul
        tabindex="0"
        class="menu menu-sm dropdown-content bg-base-100 rounded-box z-1 mt-3 w-52 p-2 shadow flex flex-col gap-4"
      >
        <li class="btn btn-outline btn-primary"><a href="/">Homepage</a></li>
        {
          isLoggedIn && (
            <li class="btn btn-outline btn-primary">
              <a href="/admin">admin</a>
            </li>
          )
        }
        {
          !isLoggedIn && (
            <li class="btn btn-outline btn-primary">
              <a href="/login">login</a>
            </li>
          )
        }
        {
          isLoggedIn && (
            <button id="logout" class="btn btn-outline btn-error" id="logout">
              log out
            </button>
          )
        }
      </ul>
    </div>
  </div>
  <div class="navbar-center">
    <span class="btn btn-ghost text-xl">Juntos en casa</span>
  </div>
  <div class="navbar-end">
    <ThemeSwitcher />
  </div>
</div>
<script>
  import { actions } from "astro:actions";

  document.addEventListener("DOMContentLoaded", () => {
    const logoutButton = document.querySelector("#logout") as HTMLButtonElement;
    logoutButton.addEventListener("click", async () => {
      await actions.logoutUser();
      window.location.href = "/login";
    });
  });
</script>
