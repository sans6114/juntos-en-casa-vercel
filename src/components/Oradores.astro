---
import type { Orador } from "../interfaces";
import OradoresCard from "./OradoresCard.astro";
import Heading from "./shared/Heading.astro";

interface Props {
  oradores: Orador[];
}

const { oradores } = Astro.props;
---

<div class="px-4 py-8 flex flex-col mx-auto gap-10">
  <h2 class="text-5xl font-bold leading-none md:ml-5">Oradores</h2>
  <div class="grid-oradores overflow-hidden">
    {oradores.map((orador) => <OradoresCard orador={orador} />)}
  </div>
</div>
<style>
  .grid-oradores {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
    gap: 3rem;
    padding: 1rem;
    border-radius: 20px;
  }
</style>
