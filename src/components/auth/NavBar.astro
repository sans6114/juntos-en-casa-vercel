---
import Logo from "../shared/Logo.astro";
import { Icon } from "astro-icon/components";
import PrimaryButton from "../shared/PrimaryButton.astro";
---

<div class="navbar shadow-accent-content bg-black px-10 h-20">
  <div class="flex-1">
    <PrimaryButton
      tamanio="md"
      href="/"
      text="Volver atrás"
      class="md:btn-md btn-sm"
      iconName="mdi:arrow-left-bold"
    />
  </div>
  <div class="flex-none">
    <Logo size="xs" />
  </div>
</div>
