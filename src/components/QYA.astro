---
import type { QYA } from "../interfaces/QYA";
import Heading from "./shared/Heading.astro";
interface Props {
  questionAnswer: QYA[];
}
const { questionAnswer } = Astro.props;
---

<div
  class="w-full max-w-4xl px-4 py-8 flex flex-col gap-4 h-screen justify-center"
  id="qya"
>
  <div class="text-start">
    <h2 class="text-4xl font-bold leading-none">Preguntas y</h2>
    <h2 class="text-4xl font-bold">respuestas</h2>
  </div>
  {
    questionAnswer.map((qa) => (
      <div class="collapse collapse-arrow bg-base-100 border border-base-300">
        <input type="radio" name="my-accordion-2" checked="checked" />
        <div class="collapse-title font-semibold">{qa.titulo}</div>
        <div class="collapse-content text-sm">
          <p>{qa.contenido}</p>
        </div>
      </div>
    ))
  }
</div>
