---
import type { Stats } from "../../interfaces";
interface Props {
  stats: Stats;
}
const { stats } = Astro.props;
console.log(stats.nombresIglesiasDif);
---

<div class="flex flex-col gap-10">
  <div class="stats stats-vertical md:stats-horizontal shadow">
    <div class="stat">
      <div class="stat-title">Inscripciones totales</div>
      <div class="stat-value">{stats.total}</div>
      <div class="stat-desc">Desde apertura</div>
    </div>

    <div class="stat">
      <div class="stat-title">Edad promedio</div>
      <div class="stat-value">{stats.promedioEdad.toFixed(1)}</div>
      <div class="stat-desc">Años</div>
    </div>

    <div class="stat">
      <div class="stat-title">Iglesia VS</div>
      <div class="stat-value">{stats.iglesiaVS}</div>
      <div class="stat-desc">Pertenecen a VS</div>
    </div>

    <div class="stat">
      <div class="stat-title">Otra iglesia</div>
      <div class="stat-value">{stats.iglesiaDif}</div>
      <div class="stat-desc">Pertenecen a otra</div>
    </div>
  </div>
  <div class="stats stats-vertical md:stats-horizontal shadow">
    <div class="stat">
      <div class="stat-title">Sin iglesia</div>
      <div class="stat-value">{stats.iglesiaNone}</div>
      <div class="stat-desc">No pertenecen</div>
    </div>
    <div class="stat">
      <div class="stat-title">Edades 12–17</div>
      <div class="stat-value">{stats.rango12a17}</div>
    </div>
    <div class="stat">
      <div class="stat-title">Edades 18–25</div>
      <div class="stat-value">{stats.rango18a25}</div>
    </div>
    <div class="stat">
      <div class="stat-title">Mayores 25</div>
      <div class="stat-value">{stats.rangoMas25}</div>
    </div>
  </div>
  <div class="w-full h-40 overflow-scroll">
    <h3 class="font-bold text-lg">
      cantidad aproximada de congregaciones: {stats.cantidadIglesiasDif}
    </h3>
    <ul>
      {
        stats.nombresIglesiasDif && stats.nombresIglesiasDif.length > 0 && (
          <>
            <ul class="list-disc list-inside">
              {stats.nombresIglesiasDif.map((iglesia) => (
                <li>{iglesia}</li>
              ))}
            </ul>
          </>
        )
      }
    </ul>
  </div>
</div>
