---
import "../styles/global.css";
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <main
      class="bg-linear-65 from-yellow-500 to-pink-500 relative flex justify-around items-center min-h-screen bg-base-200"
    >
      <slot />
    </main>
  </body>
</html>
